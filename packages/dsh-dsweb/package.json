{
  "name": "dsh-dsweb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "description": "One-click button to open the DeepSeek web chat from the DSH sidebar.",
  "author": "AnakinWu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnakinWu/DSH-plugin.git",
    "directory": "packages/dsh-dsweb"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsweb"
  ],
  "homepage": "https://github.com/AnakinWu/DSH-plugin/tree/main/packages/dsh-dsweb"
}
