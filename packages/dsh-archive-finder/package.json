{
  "name": "dsh-archive-finder",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "description": "Find and restore archived sessions, and auto-archive idle ones after 3 days.",
  "author": "AnakinWu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnakinWu/DSH-plugin.git",
    "directory": "packages/dsh-archive-finder"
  }
}
